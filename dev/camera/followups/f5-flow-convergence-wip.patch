diff --git a/core/tests/test_audio_flow_convergence.py b/core/tests/test_audio_flow_convergence.py
new file mode 100644
index 0000000..1dd9761
--- /dev/null
+++ b/core/tests/test_audio_flow_convergence.py
@@ -0,0 +1,165 @@
+# SPDX-License-Identifier: GPL-3.0-only
+"""The audio flow between two machines always gets agreed (dev/camera/reports/f5.md).
+
+Each test reproduces one way the flow stayed unagreed before F5 (offer lost, nothing asks again) and
+checks that it now converges: the offer that overtook `audio_hello` on the other link (seen live after
+a PC Beamer restart, cw11.md "Bug 2"), and a `flow_open` refused by either helper."""
+
+import unittest
+
+from core.audio import service as service_module, wire
+from core.tests.audio_cluster_harness import Net
+
+# The service's retry timings (with the values F5 gave them, so this file also runs against the code
+# before F5 and shows each test failing there).
+REOFFER_AFTER = getattr(service_module, "REOFFER_AFTER", 3.0)
+REOFFER_MAX = getattr(service_module, "REOFFER_MAX", 30.0)
+
+
+def flows_posted(node):
+    return [message["data"] for _peer, message in node.host.posted if message["type"] == wire.FLOW]
+
+
+class FlowConvergenceTests(unittest.TestCase):
+    def setUp(self):
+        self.net = Net()
+        self.addCleanup(self.net.close)
+        self.mac = self.net.add(1, "mac", "macos")       # offerer (does not listen)
+        self.pc = self.net.add(2, "lebig", "windows")    # answerer (listens on 24823)
+
+    def flow(self, node, other):
+        state = node.service._peers.get(other.id)
+        return None if state is None else state.flow
+
+    def assert_agreed(self):
+        mac, pc = self.flow(self.mac, self.pc), self.flow(self.pc, self.mac)
+        self.assertIsNotNone(mac, "the offerer has no flow")
+        self.assertIsNotNone(pc, "the answerer has no flow")
+        self.assertTrue(mac.agreed, f"flow {mac.id} never answered")
+        self.assertTrue(pc.agreed)
+        self.assertEqual(mac.id, pc.id)
+        self.assertIn(mac.id, self.mac.helper.engine.flows)
+        self.assertIn(pc.id, self.pc.helper.engine.flows)
+
+    def fail_next_flow_open(self, node, code="port_in_use"):
+        engine = node.helper.engine
+        real = engine._cmd_flow_open
+        calls = []
+
+        def flow_open(command):
+            calls.append(command)
+            if len(calls) == 1:
+                return [], code
+            return real(command)
+        engine._cmd_flow_open = flow_open
+        return calls
+
+    def test_offer_that_overtakes_the_hello_is_answered(self):
+        """Live 2026-11-12 19:50:47: the Mac's hello went on the PC's link, its offer 29 ms later on its
+        own link, and reached the PC first; the PC dropped it (no hello yet) and nothing asked again."""
+        self.net.link(self.mac, self.pc)
+        self.net.pump()
+        # What the Mac posted at link-up (hello, devices, route) stays on the slower link.
+        slow = [item for item in self.net.in_flight if item[0] == self.mac.id]
+        self.net.in_flight = [item for item in self.net.in_flight if item[0] != self.mac.id]
+        self.net.round()        # the PC's hello reaches the Mac: it offers
+        offers = [item for item in self.net.in_flight
+                  if item[2]["type"] == wire.FLOW and item[2]["data"].get("phase") == "offer"]
+        self.assertEqual(len(offers), 1)
+        self.net.round()        # the offer reaches the PC before the Mac's hello
+        self.net.in_flight = slow + self.net.in_flight
+        self.net.settle()
+        self.assert_agreed()
+        self.assertEqual(len(self.mac.helper.commands("flow_open")), 1)   # answered as it was, no re-offer
+
+    def test_offer_before_hello_converges_within_seconds_even_without_the_kept_offer(self):
+        """Same order, but the offer is lost outright (as an older answerer drops it): the offerer
+        offers again on its own."""
+        self.net.link(self.mac, self.pc)
+        self.net.pump()
+        slow = [item for item in self.net.in_flight if item[0] == self.mac.id]
+        self.net.in_flight = [item for item in self.net.in_flight if item[0] != self.mac.id]
+        self.net.round()
+        self.net.in_flight = [item for item in self.net.in_flight
+                              if not (item[2]["type"] == wire.FLOW and item[2]["data"].get("phase") == "offer")]
+        self.net.in_flight = slow + self.net.in_flight
+        self.net.settle()
+        self.net.advance(REOFFER_AFTER + 0.5)
+        self.assert_agreed()
+
+    def test_answerer_flow_open_refused_once(self):
+        """The PC's helper refuses the answer's flow_open: no answer goes back, the Mac's offer would
+        stay pending forever (and `want` was ignored while it is pending)."""
+        calls = self.fail_next_flow_open(self.pc)
+        self.net.link(self.mac, self.pc)
+        self.net.settle()
+        self.assertEqual(len(calls), 1)
+        self.net.advance(REOFFER_AFTER * 2 + 1.0)
+        self.assert_agreed()
+
+    def test_offerer_flow_open_refused_once(self):
+        """The Mac's helper refuses its own flow_open: the flow is forgotten and was never opened again."""
+        calls = self.fail_next_flow_open(self.mac)
+        self.net.link(self.mac, self.pc)
+        self.net.settle()
+        self.assertEqual(len(calls), 1)
+        self.net.advance(REOFFER_AFTER * 2 + 1.0)
+        self.assert_agreed()
+
+    def test_answerer_without_a_flow_asks_again(self):
+        """The answerer has no flow but the offerer holds no pending offer (its own flow_open was refused,
+        as an older offerer without the re-offer timer would stay): the answerer's `want` gets one."""
+        self.net.link(self.mac, self.pc)
+        self.net.settle()
+        self.assert_agreed()
+        # The PC's flow is gone (its helper lost it) while the Mac keeps an agreed one, and the Mac
+        # does not offer by itself: only the PC can ask.
+        pc_state = self.pc.service._peers[self.mac.id]
+        pc_state.flow = None
+        self.net.advance(REOFFER_AFTER + 0.5)
+        self.assertIn({"phase": "want"}, flows_posted(self.pc))
+        self.net.settle()
+        self.assert_agreed()
+
+    def test_normal_link_up_costs_one_offer_and_no_want(self):
+        """No churn on the ordinary path: one offer, one answer, nothing more, also after a while."""
+        self.net.link(self.mac, self.pc)
+        self.net.settle()
+        self.net.advance(REOFFER_MAX * 2)
+        self.assert_agreed()
+        self.assertEqual(len(self.mac.helper.commands("flow_open")), 1)
+        self.assertEqual([flow["phase"] for flow in flows_posted(self.mac)], ["offer"])
+        self.assertEqual([flow["phase"] for flow in flows_posted(self.pc)], ["answer"])
+
+    def test_retries_back_off_and_stop_once_answered(self):
+        """An answerer that never answers: offers again after 3, 6, 12, 24, 30, 30 s; then it answers."""
+        engine = self.pc.helper.engine
+        real = engine._cmd_flow_open
+        refuse = [True]
+        engine._cmd_flow_open = lambda command: ([], "port_in_use") if refuse[0] else real(command)
+        self.net.link(self.mac, self.pc)
+        self.net.settle()
+        self.net.advance(3 + 6 + 12 + 24 + 30 + 30 + 1.0, step=0.5)
+        self.assertEqual(len(self.mac.helper.commands("flow_open")), 7)   # the first and 6 again
+        refuse[0] = False
+        self.net.advance(31.0, step=0.5)
+        self.assert_agreed()
+        opens = len(self.mac.helper.commands("flow_open"))
+        self.net.advance(120.0, step=1.0)
+        self.assertEqual(len(self.mac.helper.commands("flow_open")), opens)
+
+    def test_dropped_offers_are_logged_with_the_reason(self):
+        self.net.link(self.mac, self.pc)
+        self.net.pump()
+        slow = [item for item in self.net.in_flight if item[0] == self.mac.id]
+        self.net.in_flight = [item for item in self.net.in_flight if item[0] != self.mac.id]
+        self.net.round()
+        with self.assertLogs("beamer.audio", level="INFO") as logs:
+            self.net.round()
+        self.assertTrue(any("before its audio_hello" in line for line in logs.output), logs.output)
+        self.net.in_flight = slow + self.net.in_flight
+        self.net.settle()
+
+
+if __name__ == "__main__":
+    unittest.main()
