config.json
*.log
__pycache__/
*.pyc
.venv/
venv/

.DS_Store


# Build output. Never committed and never left behind either: a .app under dist/ is indexed by
# Spotlight and turns up in Launchpad beside the real /Applications install.
native/build/


# Rendered documents, never committed
docs/pdf/

# Linux bundles, OSTree build repositories and flatpak-builder's cache.
/dist/
/.flatpak-builder/

# Offscreen audit fixtures, measurements and renders.
/renders/

# Cargo build output.
/target/

# cargo-mutants' output (the CI gate, the nightly and local runs).
/mutants.out*/
