<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Under Rosetta, libffi (every PyObjC callback) cannot map executable memory inside the hardened
         runtime without this, and `import Foundation` never finishes. Native arm64 needs nothing. -->
    <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
    <true/>
    <!-- Audio: the hardened runtime silently denies microphone capture without it. The helper
         (Contents/MacOS/beamer-audio, entitlements-audio.plist) captures; macOS attributes it to
         Beamer as the responsible process, so the app carries it too. -->
    <key>com.apple.security.device.audio-input</key>
    <true/>
</dict>
</plist>
